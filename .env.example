# Copy this file to .env (never commit .env).
# The users and password below are the PUBLIC demo credentials printed on the
# https://www.saucedemo.com login page. They are practice-site test data, not client secrets.
# In CI, provide the same variable names through the pipeline environment instead.

# Application under test (the only site authorised for this assessment)
BASE_URL=https://www.saucedemo.com

# Demo users
STANDARD_USER=standard_user
LOCKED_OUT_USER=locked_out_user
PROBLEM_USER=problem_user
PERFORMANCE_GLITCH_USER=performance_glitch_user
PASSWORD=secret_sauce

# Browser selection: chromium | firefox | webkit | comma-separated list | all
BROWSER=chromium
HEADLESS=true

# Timeouts in milliseconds
TEST_TIMEOUT=30000
ACTION_TIMEOUT=10000
NAVIGATION_TIMEOUT=15000
EXPECT_TIMEOUT=10000

# Parallel workers; 0 = Playwright default. Use 2 for local cross-browser runs (Firefox resource contention).
WORKERS=0

# Retries are 0 by default so first-run failures are visible. Do not raise this to hide flakiness.
RETRIES=0
