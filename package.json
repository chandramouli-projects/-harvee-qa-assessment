{
  "name": "harvee-qa-assessment",
  "version": "1.0.0",
  "private": true,
  "description": "Harvee Technologies QA automation assessment - Playwright + TypeScript + BDD (playwright-bdd) suite for https://www.saucedemo.com",
  "author": "Chandramouli Kancharla",
  "license": "UNLICENSED",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bddgen": "bddgen",
    "test": "bddgen && playwright test",
    "test:smoke": "bddgen && playwright test --grep @smoke",
    "test:known-defects": "bddgen && playwright test --grep @known-defect",
    "test:headed": "bddgen && cross-env HEADLESS=false playwright test",
    "test:debug": "bddgen && playwright test --debug",
    "test:ui": "bddgen && playwright test --ui",
    "test:chromium": "bddgen && cross-env BROWSER=chromium playwright test",
    "test:firefox": "bddgen && cross-env BROWSER=firefox playwright test",
    "test:webkit": "bddgen && cross-env BROWSER=webkit playwright test",
    "test:all-browsers": "bddgen && cross-env BROWSER=all playwright test",
    "report": "playwright show-report reports/html",
    "report:spark": "node scripts/generate-report.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bddgen && npm run typecheck && npm run lint && npm run format:check",
    "clean": "node -e \"for (const d of ['reports','test-results','.features-gen','logs']) require('fs').rmSync(d,{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.9",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "log4js": "^6.9.1",
    "multiple-cucumber-html-reporter": "^4.5.0",
    "playwright-bdd": "^9.2.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
